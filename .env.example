# Puerto en el que se ejecutará el servidor (por defecto 3000 o asignado por el hosting)
PORT=3000

# URL pública del juego en producción (opcional, el servidor también la detecta automáticamente)
# Ejemplo: https://punto-y-fama.onrender.com o https://mi-dominio.com
PUBLIC_URL=

# Entorno (development o production)
NODE_ENV=production
